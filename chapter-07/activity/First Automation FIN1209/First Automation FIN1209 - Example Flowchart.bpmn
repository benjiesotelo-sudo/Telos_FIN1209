<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_OscillatorExample" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="OscillatorExample" isExecutable="false">
    <bpmn:startEvent id="Start" name="Run the script">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T1" name="1. List the CSV files in the data folder">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G1" name="Another file left?">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T2" name="2. Read the file and clean its dates">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T3" name="3. Work out the RSI, MACD and stochastic">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T4" name="4. Find each oscillator&#x27;s crossings">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T5" name="5. Add the votes, keep the signal days">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T6" name="6. Draw the chart with the signals marked">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T7" name="7. Add its signals to the full list">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T8" name="8. Write output/signals.csv">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End" name="Signals and charts ready">
      <bpmn:incoming>F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="G1" />
    <bpmn:sequenceFlow id="F3" name="yes" sourceRef="G1" targetRef="T2" />
    <bpmn:sequenceFlow id="F4" sourceRef="T2" targetRef="T3" />
    <bpmn:sequenceFlow id="F5" sourceRef="T3" targetRef="T4" />
    <bpmn:sequenceFlow id="F6" sourceRef="T4" targetRef="T5" />
    <bpmn:sequenceFlow id="F7" sourceRef="T5" targetRef="T6" />
    <bpmn:sequenceFlow id="F8" sourceRef="T6" targetRef="T7" />
    <bpmn:sequenceFlow id="F9" sourceRef="T7" targetRef="G1" />
    <bpmn:sequenceFlow id="F10" name="no" sourceRef="G1" targetRef="T8" />
    <bpmn:sequenceFlow id="F11" sourceRef="T8" targetRef="End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_OscillatorExample">
    <bpmndi:BPMNPlane id="Plane_OscillatorExample" bpmnElement="OscillatorExample">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="42" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="0" y="172" width="120" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T1_di" bpmnElement="T1">
        <dc:Bounds x="125" y="115" width="130" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G1_di" bpmnElement="G1" isMarkerVisible="true">
        <dc:Bounds x="305" y="125" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="195" y="94" width="120" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T2_di" bpmnElement="T2">
        <dc:Bounds x="405" y="115" width="130" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T3_di" bpmnElement="T3">
        <dc:Bounds x="555" y="115" width="130" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T4_di" bpmnElement="T4">
        <dc:Bounds x="705" y="115" width="130" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T5_di" bpmnElement="T5">
        <dc:Bounds x="855" y="115" width="130" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T6_di" bpmnElement="T6">
        <dc:Bounds x="855" y="265" width="130" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T7_di" bpmnElement="T7">
        <dc:Bounds x="705" y="265" width="130" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T8_di" bpmnElement="T8">
        <dc:Bounds x="405" y="25" width="130" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End">
        <dc:Bounds x="602" y="42" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="560" y="82" width="120" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1">
        <di:waypoint x="78" y="150" />
        <di:waypoint x="125" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2">
        <di:waypoint x="255" y="150" />
        <di:waypoint x="305" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3">
        <di:waypoint x="355" y="150" />
        <di:waypoint x="405" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4">
        <di:waypoint x="535" y="150" />
        <di:waypoint x="555" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5">
        <di:waypoint x="685" y="150" />
        <di:waypoint x="705" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6">
        <di:waypoint x="835" y="150" />
        <di:waypoint x="855" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7">
        <di:waypoint x="920" y="185" />
        <di:waypoint x="920" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8">
        <di:waypoint x="855" y="300" />
        <di:waypoint x="835" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9">
        <di:waypoint x="705" y="300" />
        <di:waypoint x="330" y="300" />
        <di:waypoint x="330" y="175" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10">
        <di:waypoint x="330" y="125" />
        <di:waypoint x="330" y="60" />
        <di:waypoint x="405" y="60" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F11_di" bpmnElement="F11">
        <di:waypoint x="535" y="60" />
        <di:waypoint x="602" y="60" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
