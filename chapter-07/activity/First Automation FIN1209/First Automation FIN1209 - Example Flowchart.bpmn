      <bpmndi:BPMNEdge id="F14_di" bpmnElement="F14">
        <di:waypoint x="765" y="360" />
        <di:waypoint x="705" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F15_di" bpmnElement="F15">
        <di:waypoint x="575" y="360" />
