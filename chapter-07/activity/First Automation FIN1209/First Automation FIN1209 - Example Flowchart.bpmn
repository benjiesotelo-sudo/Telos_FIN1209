        <dc:Bounds x="765" y="335" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="655" y="399" width="120" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G3_di" bpmnElement="G3" isMarkerVisible="true">
        <dc:Bounds x="935" y="335" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="900" y="304" width="120" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G4_di" bpmnElement="G4" isMarkerVisible="true">
        <dc:Bounds x="1105" y="335" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1070" y="304" width="120" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T5_di" bpmnElement="T5">
        <dc:Bounds x="895" y="435" width="130" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T6_di" bpmnElement="T6">
        <dc:Bounds x="1065" y="435" width="130" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T7_di" bpmnElement="T7">
        <dc:Bounds x="575" y="325" width="130" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T8_di" bpmnElement="T8">
        <dc:Bounds x="425" y="325" width="130" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T9_di" bpmnElement="T9">
        <dc:Bounds x="575" y="25" width="130" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End">
        <dc:Bounds x="772" y="42" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="730" y="82" width="120" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1">
        <di:waypoint x="78" y="150" />
        <di:waypoint x="125" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2">
        <di:waypoint x="255" y="150" />
        <di:waypoint x="275" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3">
        <di:waypoint x="405" y="150" />
        <di:waypoint x="465" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4">
        <di:waypoint x="515" y="150" />
