<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_OopsExample" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="OopsExample" isExecutable="false">
    <bpmn:startEvent id="Start" name="Run the script">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T1" name="1. Name the data and output folders">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T2" name="2. List the CSV files in the data folder">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G1" name="Another file left?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T3" name="3. Read the file into a table">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T4" name="4. Start an empty signals table">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G2" name="Another bar left?">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G3" name="Gap up and price back to the previous high?">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G4" name="Gap down and price back to the previous low?">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T5" name="5. Record a SELL signal entry = previous high stoploss = new high">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T6" name="6. Record a BUY signal entry = previous low stoploss = new low">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T7" name="7. Draw the chart and mark the signals">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T8" name="8. Add this file&#x27;s signals to the list">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T9" name="9. Write output/signals.csv">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End" name="Signals and charts updated">
      <bpmn:incoming>F18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="F3" sourceRef="T2" targetRef="G1" />
    <bpmn:sequenceFlow id="F4" name="yes" sourceRef="G1" targetRef="T3" />
    <bpmn:sequenceFlow id="F5" sourceRef="T3" targetRef="T4" />
    <bpmn:sequenceFlow id="F6" sourceRef="T4" targetRef="G2" />
    <bpmn:sequenceFlow id="F7" name="yes" sourceRef="G2" targetRef="G3" />
    <bpmn:sequenceFlow id="F8" name="yes" sourceRef="G3" targetRef="T5" />
    <bpmn:sequenceFlow id="F9" name="no" sourceRef="G3" targetRef="G4" />
    <bpmn:sequenceFlow id="F10" name="yes" sourceRef="G4" targetRef="T6" />
    <bpmn:sequenceFlow id="F11" sourceRef="T5" targetRef="G2" />
    <bpmn:sequenceFlow id="F12" sourceRef="T6" targetRef="G2" />
    <bpmn:sequenceFlow id="F13" name="no" sourceRef="G4" targetRef="G2" />
    <bpmn:sequenceFlow id="F14" name="no" sourceRef="G2" targetRef="T7" />
    <bpmn:sequenceFlow id="F15" sourceRef="T7" targetRef="T8" />
    <bpmn:sequenceFlow id="F16" sourceRef="T8" targetRef="G1" />
    <bpmn:sequenceFlow id="F17" name="no" sourceRef="G1" targetRef="T9" />
    <bpmn:sequenceFlow id="F18" sourceRef="T9" targetRef="End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_OopsExample">
    <bpmndi:BPMNPlane id="Plane_OopsExample" bpmnElement="OopsExample">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="42" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="0" y="172" width="120" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T1_di" bpmnElement="T1">
        <dc:Bounds x="125" y="115" width="130" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T2_di" bpmnElement="T2">
        <dc:Bounds x="275" y="115" width="130" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G1_di" bpmnElement="G1" isMarkerVisible="true">
        <dc:Bounds x="465" y="125" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="355" y="94" width="120" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
