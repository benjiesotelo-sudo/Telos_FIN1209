<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_BuySellExample" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:category id="Cat_S1"><bpmn:categoryValue id="CV_S1" value="Settings and data" /></bpmn:category>
  <bpmn:category id="Cat_S2"><bpmn:categoryValue id="CV_S2" value="Measure: five votes" /></bpmn:category>
  <bpmn:category id="Cat_S3"><bpmn:categoryValue id="CV_S3" value="Signal days" /></bpmn:category>
  <bpmn:category id="Cat_S4"><bpmn:categoryValue id="CV_S4" value="Answer" /></bpmn:category>
  <bpmn:category id="Cat_S5"><bpmn:categoryValue id="CV_S5" value="Report" /></bpmn:category>
  <bpmn:process id="BuySellExample" isExecutable="false">
    <bpmn:dataObject id="DO_D1" />
    <bpmn:dataObject id="DO_D2" />
    <bpmn:dataObject id="DO_D3" />
    <bpmn:dataObject id="DO_D4" />
    <bpmn:group id="S1" categoryValueRef="CV_S1" />
    <bpmn:group id="S2" categoryValueRef="CV_S2" />
    <bpmn:group id="S3" categoryValueRef="CV_S3" />
    <bpmn:group id="S4" categoryValueRef="CV_S4" />
    <bpmn:group id="S5" categoryValueRef="CV_S5" />
    <bpmn:startEvent id="Start" name="Run the script">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T1" name="1. Read the settings: mode, stock, bought price, date">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T2" name="2. Read the data file for the stock">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:dataInputAssociation id="A1"><bpmn:sourceRef>D1</bpmn:sourceRef></bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:dataObjectReference id="D1" name="data/&lt;stock&gt;.csv" dataObjectRef="DO_D1" />
    <bpmn:textAnnotation id="N1"><bpmn:text>Input: one CSV file per stock,
about a year of daily rows.
Date (a date)
Open, High, Low, Close (prices,
numbers)
Volume (a whole number)</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Na"><bpmn:text>Price trend (Chapter 5)
Close above its 3 bar average
of closes: up, else down
(slides 109, 110)</bpmn:text></bpmn:textAnnotation>
    <bpmn:task id="T3" name="3. Vote 1: price trend up or down">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:textAnnotation id="Nb"><bpmn:text>Price bar (Chapter 7)
BUY: new low, close at or
above the previous close
SELL: new high, close at or
below it (slides 123, 126)</bpmn:text></bpmn:textAnnotation>
    <bpmn:task id="T4" name="4. Vote 2: price bar (key reversal)">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:textAnnotation id="N2"><bpmn:text>RSI, 14 days (slide 195)
BUY: crosses above 50
SELL: crosses below 50
(slide 74)</bpmn:text></bpmn:textAnnotation>
    <bpmn:task id="T5" name="5. Vote 3: RSI crossing 50">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:textAnnotation id="N3"><bpmn:text>MACD 12, 26, signal line 9
(slides 166 to 168)
BUY: MACD crosses above
its signal line
SELL: crosses below it
(slide 83)</bpmn:text></bpmn:textAnnotation>
    <bpmn:task id="T6" name="6. Vote 4: MACD crossing its signal">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:textAnnotation id="N4"><bpmn:text>Stochastic: %K 14 days,
%D = 3 day average
BUY: %K crosses above %D
SELL: %K crosses below %D
(slides 185, 187)</bpmn:text></bpmn:textAnnotation>
    <bpmn:task id="T7" name="7. Vote 5: stochastic %K crossing %D">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T8" name="8. Count the BUY and SELL votes for each day">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G2" name="3 or more of the 5 votes agree?">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T9" name="9. Record the signal day: side, trigger, stop, agree">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:textAnnotation id="N8"><bpmn:text>Volume above
the file&#x27;s average:
CONFIRMED
(slide 128).
Not a vote.</bpmn:text></bpmn:textAnnotation>
    <bpmn:exclusiveGateway id="M" name="">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G3" name="Mode: buy or sell?">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G4" name="Buy signal today?">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T10" name="10. BUY: enter above the signal day&#x27;s high, stop at its low">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:textAnnotation id="N10"><bpmn:text>Trigger above the high (slide 201).
Stop at the low: our choice
(Chapter 5, slide 74 idea).</bpmn:text></bpmn:textAnnotation>
    <bpmn:task id="T11" name="11. WAIT: show the last buy signal and what must happen next">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G5" name="Sell signal since you bought, or close below the stop?">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T12" name="12. SELL now, at about the last close, +/- % since you bought">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:textAnnotation id="N11"><bpmn:text>Sell signal after your buy day,
or a close below the stop.
Stop = the low of your buy day:
our choice (Chapter 5, slide 74).</bpmn:text></bpmn:textAnnotation>
    <bpmn:task id="T13" name="13. HOLD: stop at the low of your buy day, +/- % so far">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T14" name="14. Draw the chart, today&#x27;s answer marked on it">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:outgoing>F24</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="O1"><bpmn:targetRef>D2</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:dataObjectReference id="D2" name="chart (PNG)" dataObjectRef="DO_D2" />
    <bpmn:task id="T15" name="15. Write signals.csv and answer.txt, print the answer">
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:outgoing>F25</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="O2"><bpmn:targetRef>D3</bpmn:targetRef></bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="O3"><bpmn:targetRef>D4</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:dataObjectReference id="D3" name="signals.csv" dataObjectRef="DO_D3" />
    <bpmn:dataObjectReference id="D4" name="answer.txt" dataObjectRef="DO_D4" />
    <bpmn:endEvent id="End" name="Answer ready">
      <bpmn:incoming>F25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="F3" sourceRef="T2" targetRef="T3" />
    <bpmn:sequenceFlow id="F4" sourceRef="T3" targetRef="T4" />
    <bpmn:sequenceFlow id="F5" sourceRef="T4" targetRef="T5" />
    <bpmn:sequenceFlow id="F6" sourceRef="T5" targetRef="T6" />
    <bpmn:sequenceFlow id="F7" sourceRef="T6" targetRef="T7" />
    <bpmn:sequenceFlow id="F8" sourceRef="T7" targetRef="T8" />
    <bpmn:sequenceFlow id="F9" sourceRef="T8" targetRef="G2" />
    <bpmn:sequenceFlow id="F10" name="yes" sourceRef="G2" targetRef="T9" />
    <bpmn:sequenceFlow id="F11" sourceRef="T9" targetRef="M" />
    <bpmn:sequenceFlow id="F12" name="no: skip" sourceRef="G2" targetRef="M" />
    <bpmn:sequenceFlow id="F13" sourceRef="M" targetRef="G3" />
    <bpmn:sequenceFlow id="F14" name="buy" sourceRef="G3" targetRef="G4" />
    <bpmn:sequenceFlow id="F15" name="yes" sourceRef="G4" targetRef="T10" />
    <bpmn:sequenceFlow id="F16" name="no" sourceRef="G4" targetRef="T11" />
    <bpmn:sequenceFlow id="F17" name="sell" sourceRef="G3" targetRef="G5" />
    <bpmn:sequenceFlow id="F18" name="yes" sourceRef="G5" targetRef="T12" />
    <bpmn:sequenceFlow id="F19" name="no" sourceRef="G5" targetRef="T13" />
    <bpmn:sequenceFlow id="F20" sourceRef="T11" targetRef="T14" />
    <bpmn:sequenceFlow id="F21" sourceRef="T10" targetRef="T14" />
    <bpmn:sequenceFlow id="F22" sourceRef="T12" targetRef="T14" />
    <bpmn:sequenceFlow id="F23" sourceRef="T13" targetRef="T14" />
    <bpmn:sequenceFlow id="F24" sourceRef="T14" targetRef="T15" />
    <bpmn:sequenceFlow id="F25" sourceRef="T15" targetRef="End" />
    <bpmn:association id="A2" sourceRef="N1" targetRef="D1" />
    <bpmn:association id="Aa" sourceRef="T3" targetRef="Na" />
    <bpmn:association id="Ab" sourceRef="T4" targetRef="Nb" />
    <bpmn:association id="A3" sourceRef="T5" targetRef="N2" />
    <bpmn:association id="A4" sourceRef="T6" targetRef="N3" />
    <bpmn:association id="A5" sourceRef="T7" targetRef="N4" />
    <bpmn:association id="A6" sourceRef="T9" targetRef="N8" />
    <bpmn:association id="A7" sourceRef="T10" targetRef="N10" />
    <bpmn:association id="A8" sourceRef="T12" targetRef="N11" />
  </bpmn:process>
