<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_OscillatorExample" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:category id="Cat_S1"><bpmn:categoryValue id="CV_S1" value="Data in" /></bpmn:category>
  <bpmn:category id="Cat_S2"><bpmn:categoryValue id="CV_S2" value="Measure" /></bpmn:category>
  <bpmn:category id="Cat_S3"><bpmn:categoryValue id="CV_S3" value="Decide" /></bpmn:category>
  <bpmn:category id="Cat_S4"><bpmn:categoryValue id="CV_S4" value="Report" /></bpmn:category>
  <bpmn:process id="OscillatorExample" isExecutable="false">
    <bpmn:dataObject id="DO_D1" />
    <bpmn:dataObject id="DO_D2" />
    <bpmn:dataObject id="DO_D3" />
    <bpmn:dataObject id="DO_D4" />
    <bpmn:group id="S1" categoryValueRef="CV_S1" />
    <bpmn:group id="S2" categoryValueRef="CV_S2" />
    <bpmn:group id="S3" categoryValueRef="CV_S3" />
    <bpmn:group id="S4" categoryValueRef="CV_S4" />
    <bpmn:startEvent id="Start" name="Run the script">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T1" name="1. List the CSV files in the data folder">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T2" name="2. Read each file and clean its dates">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:dataInputAssociation id="A1"><bpmn:sourceRef>D1</bpmn:sourceRef></bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:dataObjectReference id="D1" name="data/&lt;ticker&gt;.csv" dataObjectRef="DO_D1" />
    <bpmn:textAnnotation id="N1"><bpmn:text>Input: one CSV file per stock,
about a year of daily rows.
Date (a date)
Open, High, Low, Close (prices,
numbers)
Volume (a whole number)</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="N2"><bpmn:text>RSI, 14 days (slide 195)
Equilibrium line: 50
BUY: crosses above 50
SELL: crosses below 50
(slide 74)</bpmn:text></bpmn:textAnnotation>
    <bpmn:task id="T3" name="3. Work out the RSI and its crossings">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:textAnnotation id="N3"><bpmn:text>MACD: 12 day EMA minus
26 day EMA, signal line
of 9 days (slides 166-168)
BUY: MACD crosses above
its signal line
SELL: crosses below it
(slide 83)</bpmn:text></bpmn:textAnnotation>
    <bpmn:task id="T4" name="4. Work out MACD and its crossings">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:textAnnotation id="N4"><bpmn:text>Stochastic: %K over 14 days,
%D = 3 day average of %K
(slides 185, 187)
BUY: %K crosses above %D
SELL: %K crosses below %D</bpmn:text></bpmn:textAnnotation>
    <bpmn:task id="T5" name="5. Work out the stochastic and its crossings">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T6" name="6. Count how many oscillators crossed each day">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G2" name="How many of the 3 agree?">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:textAnnotation id="N5"><bpmn:text>agree = oscillators that
crossed the same way</bpmn:text></bpmn:textAnnotation>
    <bpmn:task id="T7" name="7. Choose BUY or SELL by net vote">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G3" name="BUY or SELL?">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:textAnnotation id="N6"><bpmn:text>BUY price = the
day&#x27;s high (Lim&#x27;s
trigger, slide 201)</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="N7"><bpmn:text>SELL price = the close:
our choice, the slides
give no sell trigger</bpmn:text></bpmn:textAnnotation>
    <bpmn:task id="T8" name="8. BUY price = the day&#x27;s high">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T9" name="9. SELL price = the day&#x27;s close">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T10" name="10. Record the signal day: side, price, agree">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="M" name="">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T11" name="11. Draw the chart: price + 3 oscillators">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="O1"><bpmn:targetRef>D2</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:dataObjectReference id="D2" name="chart (PNG)" dataObjectRef="DO_D2" />
    <bpmn:task id="T12" name="12. Print summary for this stock">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="O2"><bpmn:targetRef>D3</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:dataObjectReference id="D3" name="console summary" dataObjectRef="DO_D3" />
    <bpmn:task id="T13" name="13. Add signals to the full list">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G4" name="Another file left?">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T14" name="14. Write the signals table">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="O3"><bpmn:targetRef>D4</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:dataObjectReference id="D4" name="signals.csv" dataObjectRef="DO_D4" />
    <bpmn:textAnnotation id="N8"><bpmn:text>ticker, date, side, entry,
rsi, macd, stoch (BUY, SELL,
or empty), agree (how many agree)</bpmn:text></bpmn:textAnnotation>
    <bpmn:endEvent id="End" name="Signals and charts ready">
      <bpmn:incoming>F21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="F3" sourceRef="T2" targetRef="T3" />
    <bpmn:sequenceFlow id="F4" sourceRef="T3" targetRef="T4" />
    <bpmn:sequenceFlow id="F5" sourceRef="T4" targetRef="T5" />
    <bpmn:sequenceFlow id="F6" sourceRef="T5" targetRef="T6" />
    <bpmn:sequenceFlow id="F7" sourceRef="T6" targetRef="G2" />
    <bpmn:sequenceFlow id="F8" name="1, 2 or 3" sourceRef="G2" targetRef="T7" />
    <bpmn:sequenceFlow id="F9" sourceRef="T7" targetRef="G3" />
    <bpmn:sequenceFlow id="F10" name="BUY" sourceRef="G3" targetRef="T8" />
    <bpmn:sequenceFlow id="F11" name="SELL" sourceRef="G3" targetRef="T9" />
    <bpmn:sequenceFlow id="F12" sourceRef="T8" targetRef="T10" />
    <bpmn:sequenceFlow id="F13" sourceRef="T9" targetRef="T10" />
    <bpmn:sequenceFlow id="F14" name="none: skip" sourceRef="G2" targetRef="M" />
    <bpmn:sequenceFlow id="F15" sourceRef="T10" targetRef="M" />
    <bpmn:sequenceFlow id="F16" sourceRef="M" targetRef="T11" />
    <bpmn:sequenceFlow id="F17" sourceRef="T11" targetRef="T12" />
    <bpmn:sequenceFlow id="F18" sourceRef="T12" targetRef="T13" />
    <bpmn:sequenceFlow id="F19" sourceRef="T13" targetRef="G4" />
    <bpmn:sequenceFlow id="F20" name="no" sourceRef="G4" targetRef="T14" />
    <bpmn:sequenceFlow id="F21" sourceRef="T14" targetRef="End" />
    <bpmn:sequenceFlow id="F22" name="yes" sourceRef="G4" targetRef="T2" />
    <bpmn:association id="A2" sourceRef="N1" targetRef="D1" />
    <bpmn:association id="A3" sourceRef="T3" targetRef="N2" />
    <bpmn:association id="A4" sourceRef="T4" targetRef="N3" />
    <bpmn:association id="A5" sourceRef="T5" targetRef="N4" />
    <bpmn:association id="A6" sourceRef="G2" targetRef="N5" />
    <bpmn:association id="A7" sourceRef="T8" targetRef="N6" />
    <bpmn:association id="A8" sourceRef="T9" targetRef="N7" />
    <bpmn:association id="A9" sourceRef="D4" targetRef="N8" />
  </bpmn:process>
