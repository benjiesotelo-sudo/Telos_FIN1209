      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A2_di" bpmnElement="A2">
        <di:waypoint x="140" y="528" />
        <di:waypoint x="140" y="465" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3">
        <di:waypoint x="205" y="300" />
        <di:waypoint x="250" y="300" />
        <di:waypoint x="250" y="55" />
        <di:waypoint x="610" y="55" />
        <di:waypoint x="610" y="108" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Aa_di" bpmnElement="Aa">
        <di:waypoint x="545" y="140" />
