      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F16_di" bpmnElement="F16">
        <di:waypoint x="490" y="325" />
        <di:waypoint x="490" y="175" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F17_di" bpmnElement="F17">
        <di:waypoint x="490" y="125" />
        <di:waypoint x="490" y="60" />
        <di:waypoint x="575" y="60" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F18_di" bpmnElement="F18">
        <di:waypoint x="705" y="60" />
